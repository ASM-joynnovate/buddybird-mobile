{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": false,
	"singleQuote": false,
	"trailingComma": "all",
	"quoteProps": "consistent",
	"sortPackageJson": true,
	"sortImports": { "internalPattern": ["@/", "@assets/", "@modules/"] },
	"ignorePatterns": ["node_modules", "ios", "android", "dist", ".expo"]
}
