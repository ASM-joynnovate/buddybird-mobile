   // endregion
 
+  override fun cropImage() {
+    // The output file under <cacheDir>/ImagePicker is pre-created when the crop intent is
+    // built, but the OS or vendor cleaners may wipe the cache while the crop screen is open.
+    // `writeBitmapToUri` does not recreate the parent directory, so the write would crash the
+    // process with a fatal FileNotFoundException (ENOENT). Recreate the directory just before
+    // cropping so the output stream can be opened again. Relies on customOutputUri being a
+    // file:// URI, which CropImageContract always builds from the cache directory.
+    val outputPath = getCropOptions()?.customOutputUri?.path
+    if (outputPath != null) {
+      java.io.File(outputPath).parentFile?.mkdirs()
+    } else {
+      android.util.Log.w("ExpoCropImageActivity", "Could not read customOutputUri via reflection; skipping output dir recreation")
+    }
+    super.cropImage()
+  }
