-class ImagePickerFileProvider : FileProvider()
+class ImagePickerFileProvider : FileProvider() {
+  override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor? {
+    if (mode.contains('w') && uri.pathSegments.take(2) == listOf("cached_expo_files", ImagePickerConstants.CACHE_DIR_NAME)) {
+      // The OS can remove the output cache while the crop editor remains open.
+      File(requireNotNull(context).cacheDir, ImagePickerConstants.CACHE_DIR_NAME).mkdirs()
+    }
+    return super.openFile(uri, mode)
+  }
