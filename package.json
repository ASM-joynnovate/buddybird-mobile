	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@tanstack/eslint-plugin-query": "5.104.0",
		"@types/d3-scale": "^4.0.3",
		"@types/node": "^22.0.0",
		"@types/react": "~19.2.10",
		"dependency-cruiser": "^18.4.0",
		"eslint": "10.11.0",
		"eslint-plugin-react-native-a11y": "3.5.1",
		"husky": "9.1.7",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"oxlint-config-universe": "0.2.0",
		"oxlint-plugin-react-native": "0.2.36",
		"oxlint-tsgolint": "7.0.2003",
		"tsx": "4.23.15",
		"typescript": "~6.0.3"
	},
	"engines": {
		"node": ">=22.14.0"
	},
	"packageManager": "yarn@4.18.1",
	"expo": {
		"install": {
			"exclude": [
				"@sentry/react-native",
				"@shopify/react-native-skia",
				"react-native-gesture-handler",
				"react-native-reanimated",
				"react-native-safe-area-context",
				"react-native-screens",
				"react-native-svg",
				"react-native-worklets"
			]
		},
		"autolinking": {
			"android": {
				"buildFromSource": [
					"expo-image-picker"
				]
			}
		}
	}
}
