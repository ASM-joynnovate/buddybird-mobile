{
	"name": "buddybird-mobile",
	"version": "1.2.0",
	"private": true,
	"main": "index.tsx",
	"scripts": {
		"start": "expo start --dev-client",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"prebuild": "expo prebuild",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint app plugins *.js *.ts *.tsx",
		"lint:fix": "oxlint --fix app plugins *.js *.ts *.tsx",
		"format": "oxfmt app plugins docs *.json *.js *.ts *.tsx",
		"format:check": "oxfmt --check app plugins docs *.json *.js *.ts *.tsx",
		"check:deps": "depcruise app --config .dependency-cruiser.cjs",
		"test": "node --import tsx --test \"app/**/*.test.ts\"",
		"check": "yarn typecheck && yarn lint && yarn format:check && yarn check:deps && npx expo install --check",
		"export:ios": "expo export --platform ios",
		"export:android": "expo export --platform android",
		"postinstall": "node .husky/install.mjs"
	},
	"dependencies": {
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/netinfo": "12.0.1",
		"@react-native-firebase/analytics": "23.8.8",
		"@react-native-firebase/app": "23.8.8",
		"@react-native-firebase/crashlytics": "23.8.8",
		"@react-native-firebase/messaging": "23.8.8",
		"@react-navigation/bottom-tabs": "^7.2.0",
		"@react-navigation/native": "^7.0.14",
		"@react-navigation/native-stack": "^7.2.0",
		"@supabase/supabase-js": "2.116.0",
		"@tanstack/react-query": "5.102.8",
		"dayjs": "^1.11.23",
		"es-hangul": "2.4.0",
		"expo": "~56.0.23",
		"expo-apple-authentication": "~56.0.4",
		"expo-application": "~56.0.3",
		"expo-asset": "~56.0.25",
		"expo-audio": "~56.0.13",
		"expo-battery": "~56.0.4",
		"expo-build-properties": "~56.0.27",
		"expo-constants": "~56.0.27",
		"expo-crypto": "~56.0.5",
		"expo-dev-client": "~56.0.27",
		"expo-device": "~56.0.4",
		"expo-file-system": "~56.0.11",
		"expo-font": "~56.0.7",
		"expo-image-picker": "patch:expo-image-picker@npm%3A56.0.25#~/.yarn/patches/expo-image-picker-npm-56.0.25-e96cfa6608.patch",
		"expo-keep-awake": "~56.0.3",
		"expo-localization": "~56.0.6",
		"expo-notifications": "~56.0.26",
		"expo-secure-store": "~56.0.4",
		"expo-splash-screen": "~56.0.15",
		"expo-system-ui": "~56.0.5",
		"expo-tracking-transparency": "~56.0.5",
		"expo-web-browser": "~56.0.6",
		"i18next": "^23.14.0",
		"intl-pluralrules": "^2.0.1",
		"lucide-react-native": "^1.48.0",
		"react": "19.2.3",
		"react-i18next": "^15.0.1",
		"react-native": "0.85.3",
		"react-native-audio-api": "^0.13.6",
		"react-native-clarity": "^4.4.1",
		"react-native-gesture-handler": "~2.31.1",
		"react-native-mmkv": "3.3.3",
		"react-native-reanimated": "4.3.4",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-worklets": "0.8.3",
		"zod": "^4.6.5",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@tanstack/eslint-plugin-query": "5.102.8",
		"@types/node": "^22.0.0",
		"@types/react": "~19.2.10",
		"dependency-cruiser": "^17.0.2",
		"eslint": "10.10.0",
		"eslint-plugin-react-native-a11y": "3.5.1",
		"husky": "9.1.7",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"oxlint-config-universe": "0.2.0",
		"oxlint-plugin-react-native": "0.2.34",
		"oxlint-tsgolint": "7.0.2001",
		"tsx": "4.23.15",
		"typescript": "~6.0.3"
	},
	"engines": {
		"node": ">=22.14.0"
	},
	"packageManager": "yarn@4.18.0",
	"expo": {
		"install": {
			"exclude": [
				"react-native-reanimated"
			]
		},
		"autolinking": {
			"android": {
				"buildFromSource": [
					"expo-image-picker"
				]
			}
		}
	}
}
