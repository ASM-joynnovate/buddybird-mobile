{
	"name": "buddybird-mobile",
	"version": "1.2.0",
	"private": true,
	"main": "index.tsx",
	"scripts": {
		"start": "expo start --dev-client",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"prebuild": "expo prebuild",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint app modules plugins *.js *.ts *.tsx",
		"lint:fix": "oxlint --fix app modules plugins *.js *.ts *.tsx",
		"format": "oxfmt app modules plugins docs *.json *.js *.ts *.tsx",
		"format:check": "oxfmt --check app modules plugins docs *.json *.js *.ts *.tsx",
		"check:deps": "depcruise app modules --config .dependency-cruiser.cjs",
		"check": "yarn typecheck && yarn lint && yarn format:check && yarn check:deps && npx expo install --check",
		"test:maestro:ios": "test -n \"$0\" && APP_VARIANT=development expo prebuild --platform ios --no-install && APP_VARIANT=development expo run:ios --configuration Release --device \"$0\" --no-bundler && maestro --device \"$0\" test --include-tags full .maestro",
		"test:maestro:android": "test -n \"$0\" && APP_VARIANT=development expo prebuild --platform android --no-install && APP_VARIANT=development android/gradlew -p android :app:assembleRelease && adb -s \"$0\" install -r android/app/build/outputs/apk/release/app-release.apk && maestro --device \"$0\" test --include-tags full .maestro",
		"export:ios": "expo export --platform ios",
		"export:android": "expo export --platform android",
		"postinstall": "node .husky/install.mjs"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/netinfo": "11.5.2",
		"@react-native-firebase/analytics": "23.8.8",
		"@react-native-firebase/app": "23.8.8",
		"@react-native-firebase/auth": "23.8.8",
		"@react-native-firebase/crashlytics": "23.8.8",
		"@react-native-firebase/firestore": "23.8.8",
		"@react-native-firebase/messaging": "23.8.8",
		"@react-native-firebase/remote-config": "23.8.8",
		"@react-native-picker/picker": "2.11.4",
		"@react-navigation/bottom-tabs": "^7.2.0",
		"@react-navigation/native": "^7.0.14",
		"@react-navigation/native-stack": "^7.2.0",
		"@supabase/supabase-js": "2.116.0",
		"@tanstack/react-query": "5.102.8",
		"expo": "~55.0.31",
		"expo-apple-authentication": "~55.0.8",
		"expo-application": "~55.0.8",
		"expo-asset": "~55.0.7",
		"expo-audio": "~55.0.8",
		"expo-build-properties": "~55.0.9",
		"expo-constants": "~55.0.9",
		"expo-crypto": "~55.0.8",
		"expo-dev-client": "~55.0.11",
		"expo-device": "~55.0.9",
		"expo-file-system": "~55.0.10",
		"expo-font": "~55.0.4",
		"expo-image-picker": "~55.0.10",
		"expo-keep-awake": "~55.0.8",
		"expo-linking": "~55.0.7",
		"expo-localization": "~55.0.8",
		"expo-notifications": "~55.0.10",
		"expo-secure-store": "~55.0.8",
		"expo-splash-screen": "~55.0.10",
		"expo-symbols": "~55.0.9",
		"expo-system-ui": "~55.0.9",
		"expo-tracking-transparency": "~55.0.8",
		"expo-web-browser": "~55.0.9",
		"i18next": "^23.14.0",
		"intl-pluralrules": "^2.0.1",
		"react": "19.2.0",
		"react-i18next": "^15.0.1",
		"react-native": "0.83.10",
		"react-native-clarity": "^4.4.1",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-mmkv": "3.3.3",
		"react-native-reanimated": "4.2.1",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-screens": "~4.23.0",
		"react-native-svg": "15.15.3",
		"react-native-worklets": "0.7.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@tanstack/eslint-plugin-query": "5.102.8",
		"@types/node": "^22.0.0",
		"@types/react": "~19.2.10",
		"dependency-cruiser": "^17.0.2",
		"eslint": "10.10.0",
		"eslint-plugin-react-native-a11y": "3.5.1",
		"husky": "9.1.7",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"oxlint-config-universe": "0.2.0",
		"oxlint-plugin-react-native": "0.2.34",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "~5.9.2"
	},
	"resolutions": {
		"expo-image-picker@npm:~55.0.10": "patch:expo-image-picker@npm%3A55.0.24#~/.yarn/patches/expo-image-picker-npm-55.0.24-32e3d2a694.patch"
	},
	"engines": {
		"node": ">=22.14.0"
	},
	"packageManager": "yarn@4.18.0",
	"expo": {
		"autolinking": {
			"android": {
				"buildFromSource": [
					"expo-image-picker"
				]
			}
		}
	}
}
