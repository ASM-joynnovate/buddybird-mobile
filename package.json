{
	"name": "buddybird-mobile",
	"version": "2.1.0",
	"private": true,
	"main": "index.tsx",
	"scripts": {
		"start": "expo start --dev-client",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"prebuild": "expo prebuild",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint app plugins targets *.js *.ts *.tsx",
		"lint:fix": "oxlint --fix app plugins targets *.js *.ts *.tsx",
		"format": "oxfmt app plugins targets docs *.json *.js *.ts *.tsx",
		"format:check": "oxfmt --check app plugins targets docs *.json *.js *.ts *.tsx",
		"check:deps": "depcruise app --config .dependency-cruiser.cjs",
		"test": "node --import tsx --test \"app/**/*.test.ts\"",
		"check": "yarn typecheck && yarn lint && yarn format:check && yarn check:deps && npx expo install --check",
		"export:ios": "expo export --platform ios",
		"export:android": "expo export --platform android",
		"postinstall": "node .husky/install.mjs"
	},
	"dependencies": {
		"@bacons/apple-targets": "^5.0.0",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@nandorojo/galeria": "^3.0.3",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/netinfo": "12.0.1",
		"@react-native-firebase/analytics": "26.4.0",
		"@react-native-firebase/app": "26.4.0",
		"@react-native-firebase/crashlytics": "26.4.0",
		"@react-native-firebase/messaging": "26.4.0",
		"@react-navigation/bottom-tabs": "^7.20.0",
		"@react-navigation/native": "^7.5.0",
		"@react-navigation/native-stack": "^7.20.0",
		"@sentry/react-native": "~8.29.0",
		"@shopify/react-native-skia": "2.6.9",
		"@supabase/supabase-js": "2.117.2",
		"@tanstack/react-query": "5.104.0",
		"dayjs": "^1.11.23",
		"es-hangul": "2.4.0",
		"expo": "~57.0.26",
		"expo-apple-authentication": "~57.0.2",
		"expo-application": "~57.0.3",
		"expo-asset": "~57.0.18",
		"expo-audio": "~57.0.5",
		"expo-battery": "~57.0.3",
		"expo-build-properties": "~57.0.22",
		"expo-constants": "~57.0.20",
		"expo-crypto": "~57.0.3",
		"expo-dev-client": "~57.0.19",
		"expo-device": "~57.0.2",
		"expo-file-system": "~57.0.7",
		"expo-font": "~57.0.4",
		"expo-image-picker": "patch:expo-image-picker@npm%3A57.0.20#~/.yarn/patches/expo-image-picker-npm-57.0.20-b36f96d5eb.patch",
		"expo-keep-awake": "~57.0.2",
		"expo-localization": "~57.0.2",
		"expo-notifications": "~57.0.21",
		"expo-secure-store": "~57.0.4",
		"expo-splash-screen": "~57.0.9",
		"expo-system-ui": "~57.0.4",
		"expo-tracking-transparency": "~57.0.2",
		"expo-web-browser": "~57.0.3",
		"i18next": "^26.4.2",
		"intl-pluralrules": "^2.0.1",
		"lucide-react-native": "^1.49.0",
		"react": "19.2.3",
		"react-i18next": "^17.0.15",
		"react-native": "0.86.3",
		"react-native-audio-api": "^0.13.6",
		"react-native-clarity": "^4.9.1",
		"react-native-gesture-handler": "~2.33.0",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-mmkv": "4.3.2",
		"react-native-nitro-modules": "0.37.1",
		"react-native-reanimated": "4.6.0",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.28.0",
		"react-native-svg": "15.15.5",
		"react-native-volume-manager": "2.2.0",
		"react-native-worklets": "0.12.2",
		"victory-native": "^42.0.1",
		"zod": "^4.6.5",
		"zustand": "5.0.15"
