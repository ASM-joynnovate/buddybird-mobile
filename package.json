{
  "name": "buddybird-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app modules test plugins *.js *.ts *.tsx",
    "format": "prettier --write app modules test plugins docs *.json *.js *.ts *.tsx",
    "test": "tsx --test test/*.test.ts",
    "check:deps": "depcruise app modules --config .dependency-cruiser.cjs",
    "check": "yarn typecheck && yarn lint && yarn test && yarn check:deps",
    "test:maestro": "maestro test .maestro",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/analytics": "23.8.8",
    "@react-native-firebase/app": "23.8.8",
    "@react-native-firebase/auth": "23.8.8",
    "@react-native-firebase/crashlytics": "23.8.8",
    "@react-native-firebase/firestore": "23.8.8",
    "@react-native-firebase/messaging": "23.8.8",
    "@react-native-firebase/remote-config": "23.8.8",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@tanstack/react-query": "5.102.8",
    "expo": "55.0.5",
    "expo-application": "~55.0.8",
    "expo-asset": "~55.0.7",
    "expo-audio": "~55.0.8",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.8",
    "expo-dev-client": "~55.0.11",
    "expo-device": "~55.0.9",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-image-picker": "~55.0.10",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-notifications": "~55.0.10",
    "expo-splash-screen": "~55.0.10",
    "expo-system-ui": "~55.0.9",
    "expo-tracking-transparency": "~55.0.8",
    "fflate": "0.8.3",
    "i18next": "^23.14.0",
    "react": "19.2.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.83.2",
    "react-native-clarity": "^4.4.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "3.3.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.10",
    "dependency-cruiser": "^17.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "yarn@4.14.1"
}
