{
	"cli": {
		"version": ">= 18.13.1",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "development"
			}
		},
		"preview": {
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "development"
			}
		},
		"staging": {
			"distribution": "store",
			"environment": "preview",
			"autoIncrement": true,
			"env": {
				"APP_VARIANT": "development"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"APP_VARIANT": "production",
				"SENTRY_ENVIRONMENT": "prod"
			}
		}
	},
	"submit": {
		"store": {
			"android": {
				"serviceAccountKeyPath": "/tmp/play-service-account.json"
			},
			"ios": {
				"appleTeamId": "73TZC3K2JG",
				"ascApiKeyPath": "/tmp/asc-api-key.p8",
				"ascApiKeyId": "DDGR4YT335",
				"ascApiKeyIssuerId": "11e3701a-619c-42b5-acba-e51ce26fc466"
			}
		},
		"staging": {
			"extends": "store",
			"android": {
				"track": "internal",
				"releaseStatus": "completed",
				"changesNotSentForReview": false
			},
			"ios": {
				"ascAppId": "6784253530",
				"groups": ["joynnovate"]
			}
		},
		"production": {
			"extends": "store",
			"android": {
				"track": "production",
				"releaseStatus": "draft"
			},
			"ios": {
				"ascAppId": "6783652711"
			}
		}
	}
}
